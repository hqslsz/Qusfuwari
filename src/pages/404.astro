---
import Layout from "../layouts/Layout.astro";
---

<Layout title="404 - 页面未找到">
	<div class="min-h-screen flex flex-col items-center justify-center px-4">
		<div class="text-center max-w-md">
			<!-- Miku GIF -->
			<img
				src="https://morbol.qus.moe/loading/miku_loading.gif"
				alt="Miku 404"
				class="w-48 h-48 mx-auto mb-6 rounded-2xl object-cover drop-shadow-lg"
				style="image-rendering: pixelated;"
			/>

			<!-- 404 大字 -->
			<h1 class="text-8xl font-bold mb-2 tracking-tight" style="color: var(--primary);">404</h1>

			<!-- 提示语 -->
			<p class="text-xl text-black/60 mb-2">页面走丢了</p>
			<p class="text-sm text-black/40 mb-8">你访问的页面不存在，也许它去了另一个世界</p>

			<!-- 返回首页按钮 -->
			<a
				href="/"
				class="inline-flex items-center gap-2 px-6 py-3 rounded-xl font-medium text-[var(--btn-content)] bg-[var(--btn-regular-bg)] hover:bg-[var(--btn-regular-bg-hover)] active:bg-[var(--btn-regular-bg-active)] transition"
			>
				<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
					<polyline points="9 22 9 12 15 12 15 22"></polyline>
				</svg>
				返回首页
			</a>
		</div>
	</div>
</Layout>
