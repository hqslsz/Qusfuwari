---
import Layout from "../layouts/Layout.astro";
---

<Layout title="404 - 页面未找到">
	<div class="min-h-screen flex flex-col items-center justify-center px-4">
		<div class="text-center max-w-md">
			<img
				src="https://morbol.qus.moe/loading/miku_loading.gif"
				alt="Miku 404"
				class="w-48 h-48 mx-auto mb-6 rounded-2xl object-cover drop-shadow-lg"
				style="image-rendering: pixelated;"
			/>

			<h1 class="text-8xl font-bold mb-2 tracking-tight" style="color: black;">404</h1>

			<p class="text-xl text-black/60 mb-2">页面走丢了</p>
			<p class="text-sm text-black/40 mb-8">你访问的页面不存在，也许它去了另一个世界</p>

			<a href="/" class="home-button">
				<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
					<polyline points="9 22 9 12 15 12 15 22"></polyline>
				</svg>
				返回首页
			</a>
		</div>
	</div>
</Layout>

<style>
	.home-button {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.75rem 2rem;
		background: oklch(0.65 0.15 var(--hue));
		color: white;
		border: none;
		border-radius: 8px;
		font-size: 0.95rem;
		font-weight: 600;
		text-decoration: none;
		cursor: pointer;
		transition: all 0.2s ease;
		box-shadow: 0 2px 8px oklch(0.65 0.15 var(--hue) / 0.3);
	}

	.home-button:hover {
		background: oklch(0.70 0.16 var(--hue));
		transform: translateY(-1px);
		box-shadow: 0 4px 12px oklch(0.65 0.15 var(--hue) / 0.4);
	}

	.home-button:active {
		transform: translateY(0);
		box-shadow: 0 1px 4px oklch(0.65 0.15 var(--hue) / 0.3);
	}
</style>
