width='1' height='1' fill='%23181425' fill-opacity='0.23'/%3E%3Crect x='1' y='6' width='1' height='1' fill='%23181425' fill-opacity='0.73'/%3E%3Crect x='2' y='6' width='1' height='1' fill='%23181425' fill-opacity='0.11'/%3E%3Crect x='3' y='6' width='1' height='1' fill='%23181425' fill-opacity='0.61'/%3E%3Crect x='4' y='6' width='1' height='1' fill='%23181425' fill-opacity='0.20'/%3E%3Crect x='5' y='6' width='1' height='1' fill='%23181425' fill-opacity='0.70'/%3E%3Crect x='6' y='6' width='1' height='1' fill='%23181425' fill-opacity='0.08'/%3E%3Crect x='7' y='6' width='1' height='1' fill='%23181425' fill-opacity='0.58'/%3E%3Crect x='0' y='7' width='1' height='1' fill='%23181425' fill-opacity='0.98'/%3E%3Crect x='1' y='7' width='1' height='1' fill='%23181425' fill-opacity='0.48'/%3E%3Crect x='2' y='7' width='1' height='1' fill='%23181425' fill-opacity='0.86'/%3E%3Crect x='3' y='7' width='1' height='1' fill='%23181425' fill-opacity='0.36'/%3E%3Crect x='4' y='7' width='1' height='1' fill='%23181425' fill-opacity='0.95'/%3E%3Crect x='5' y='7' width='1' height='1' fill='%23181425' fill-opacity='0.45'/%3E%3Crect x='6' y='7' width='1' height='1' fill='%23181425' fill-opacity='0.83'/%3E%3Crect x='7' y='7' width='1' height='1' fill='%23181425' fill-opacity='0.33'/%3E%3C/svg%3E"),
			linear-gradient(135deg, var(--dither-color-1) 0%, var(--dither-color-2) 100%);
		background-size: 8px 8px, 100% 100%;
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
		text-shadow: none;
		filter: drop-shadow(0 2px 20px rgba(24, 20, 37, 0.5));
	}

	/* 打字机效果副标题 */
	.hero-subtitle {
		font-size: clamp(1.25rem, 4vw, 1.75rem);
		margin-bottom: 2.5rem;
		min-height: 1.8em;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.typing-text {
