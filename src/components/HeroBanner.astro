---
/**
 * HeroBanner 组件 - ASCII Logo 交互式全屏横幅
 * 特点：直接渲染用户自定义的 ASCII Art 图案，鼠标滑过产生排斥效果
 */
import { Icon } from "astro-icon/components";
// 从 txt 文件读取 ASCII Art，格式化器不会动纯文本文件
import asciiLogoFile from "../ascii-logo.txt?raw";
import { siteConfig } from "../config";

interface Props {
	class?: string;
}

const { class: className } = Astro.props;
const heroBannerConfig = siteConfig.heroBanner;
const showScrollIndicator = heroBannerConfig?.showScrollIndicator ?? true;

// 优先使用 config 中的配置，否则从 txt 文件读取
const asciiLogoRaw: string =
	heroBannerConfig?.asciiLogo || asciiLogoFile || siteConfig.title;
const asciiLogo: string[] = asciiLogoRaw
	.split("\n")
	.filter((line) => line.trimEnd().length > 0);
---

<section id="hero-banner" class:list={["hero-banner", className]} data-ascii-logo={asciiLogoRaw}>
	<!-- 背景层 -->
	<div class="hero-bg">
		<div class="hero-overlay"></div>
	</div>

	<!-- ASCII Logo Canvas -->
	<div class="hero-content">
		<canvas id="ascii-canvas" class="ascii-canvas"></canvas>
	</div>

	<!-- 向下滚动指示器 -->
	{showScrollIndicator && (
		<div class="hero-scroll-indicator" id="scroll-indicator">
			<div class="scroll-mouse">
				<div class="scroll-wheel"></div>
			</div>
			<span class="scroll-text">向下滚动</span>
			<Icon name="fa6-solid:chevron-down" class="scroll-arrow" />
		</div>
	)}
</section>

<script>
	/**
	 * ASCII Art 粒子系统
	 * 直接读取用户自定义的 ASCII Art 图案，每个非空字符变成一个可交互的粒子
	 * 字体大小自动适配 banner 尺寸
	 */
	class AsciiLogoSystem {
		private canvas: HTMLCanvasElement | null = null;
		private ctx: CanvasRenderingContext2D | null = null;
		private particles: AsciiParticle[] = [];
		private mouse = { x: -9999, y: -9999 };
		private animationId: number = 0;
		private isVisible: boolean = true;
		private isDestroyed: boolean = false;
		private resizeHandler: () => void = () => {};
		private mouseMoveHandler: (e: MouseEvent) => void = () => {};
		private mouseLeaveHandler: () => void = () => {};
		private touchMoveHandler: (e: TouchEvent) => void = () => {};
		private touchEndHandler: () => void = () => {};
		private lines: string[] = [];
		private dpr: number = 1;

		constructor(canvasId: string, lines: string[]) {
			this.canvas = document.getElementById(canvasId) as HTMLCanvasElement;
			this.lines = lines;

			if (!this.canvas) return;

			const ctx = this.canvas.getContext('2d', { alpha: true });
			if (!ctx) return;
			this.ctx = ctx;

			this.dpr = Math.min(window.devicePixelRatio || 1, 2);

			this.resizeHandler = () => {
				this.resize();
				this.createParticles();
			};

			this.mouseMoveHandler = (e: MouseEvent) => {
				if (!this.canvas) return;
				const rect = this.canvas.getBoundingClientRect();
				this.mouse.x = (e.clientX - rect.left) * this.dpr;
				this.mouse.y = (e.clientY - rect.top) * this.dpr;
			};

			this.mouseLeaveHandler = () => {
				this.mouse.x = -9999;
				this.mouse.y = -9999;
			};

			this.touchMoveHandler = (e: TouchEvent) => {
				if (!this.canvas || e.touches.length === 0) return;
				const rect = this.canvas.getBoundingClientRect();
				this.mouse.x = (e.touches[0].clientX - rect.left) * this.dpr;
				this.mouse.y = (e.touches[0].clientY - rect.top) * this.dpr;
			};

			this.touchEndHandler = () => {
				this.mouse.x = -9999;
				this.mouse.y = -9999;
			};

			this.resize();
			this.createParticles();
			this.bindEvents();
			this.animate();

			// 页面不可见时暂停动画
			document.addEventListener('visibilitychange', () => {
				this.isVisible = !document.hidden;
				if (this.isVisible && !this.isDestroyed) this.animate();
			});
		}

		private resize() {
			if (!this.canvas) return;
			const parent = this.canvas.parentElement;
			if (!parent) return;
			const w = parent.clientWidth;
			const h = parent.clientHeight;
			this.canvas.width = w * this.dpr;
			this.canvas.height = h * this.dpr;
			this.canvas.style.width = `${w}px`;
			this.canvas.style.height = `${h}px`;
		}

		private createParticles() {
			if (!this.canvas || !this.ctx) return;
			this.particles = [];

			const canvasW = this.canvas.width;
			const canvasH = this.canvas.height;

			if (this.lines.length === 0) return;

			// 计算 ASCII Art 的行数和最大列数
			const rows = this.lines.length;
			const cols = Math.max(...this.lines.map(l => l.length));

			if (rows === 0 || cols === 0) return;

			// 自动计算字体大小，使 ASCII Art 适配 canvas
			// 留出上下左右各 15% 的边距
			const marginX = canvasW * 0.15;
			const marginY = canvasH * 0.15;
			const availW = canvasW - marginX * 2;
			const availH = canvasH - marginY * 2;

			// 等宽字体的宽高比约为 0.6
			const charAspect = 0.6;
			// 根据可用空间计算字体大小
			const fontSizeByWidth = availW / (cols * charAspect);
			const fontSizeByHeight = availH / rows;
			const fontSize = Math.min(fontSizeByWidth, fontSizeByHeight);

			// 实际字符间距
			const charW = fontSize * charAspect;
			const charH = fontSize;

			// 计算整个 ASCII Art 的实际宽高，用于居中
			const totalW = cols * charW;
			const totalH = rows * charH;
			const offsetX = (canvasW - totalW) / 2;
			const offsetY = (canvasH - totalH) / 2;

			// 遍历每个字符，非空格字符创建粒子
			for (let row = 0; row < rows; row++) {
				const line = this.lines[row];
				for (let col = 0; col < line.length; col++) {
					const char = line[col];
					if (char === ' ') continue; // 跳过空格

					const x = offsetX + col * charW + charW / 2;
					const y = offsetY + row * charH + charH / 2;

					this.particles.push({
						x: x,
						y: y,
						originX: x,
						originY: y,
						vx: 0,
						vy: 0,
						char: char,
						fontSize: fontSize,
						color: `rgba(255, 255, 255, ${0.75 + Math.random() * 0.25})`,
					});
				}
			}
		}

		private bindEvents() {
			window.addEventListener('resize', this.resizeHandler);

			// 使用 hero-banner 容器监听事件
			const heroBanner = document.getElementById('hero-banner');
			const target = heroBanner || this.canvas;
			if (target) {
				target.addEventListener('mousemove', this.mouseMoveHandler);
				target.addEventListener('mouseleave', this.mouseLeaveHandler);
				target.addEventListener('touchmove', this.touchMoveHandler, { passive: true });
				target.addEventListener('touchend', this.touchEndHandler);
			}
		}

		private animate() {
			if (!this.ctx || !this.canvas || !this.isVisible || this.isDestroyed) return;

			const ctx = this.ctx;
			const canvasW = this.canvas.width;
			const canvasH = this.canvas.height;

			ctx.clearRect(0, 0, canvasW, canvasH);

			const mouseRadius = 80 * this.dpr; // 鼠标影响半径
			const mouseRadiusSq = mouseRadius * mouseRadius;
			const repulsionForce = 6; // 排斥力强度
			const friction = 0.85; // 摩擦力
			const returnSpeed = 0.08; // 回归速度

			for (let i = 0; i < this.particles.length; i++) {
				const p = this.particles[i];

				// 鼠标排斥力
				const dx = p.x - this.mouse.x;
				const dy = p.y - this.mouse.y;
				const distSq = dx * dx + dy * dy;

				if (distSq < mouseRadiusSq && distSq > 0) {
					const dist = Math.sqrt(distSq);
					const force = (mouseRadius - dist) / mouseRadius * repulsionForce;
					const angle = Math.atan2(dy, dx);
					p.vx += Math.cos(angle) * force;
					p.vy += Math.sin(angle) * force;
				}

				// 回归原位的弹性力
				p.vx += (p.originX - p.x) * returnSpeed;
				p.vy += (p.originY - p.y) * returnSpeed;

				// 摩擦力
				p.vx *= friction;
				p.vy *= friction;

				// 更新位置
				p.x += p.vx;
				p.y += p.vy;

				// 绘制字符
				ctx.fillStyle = p.color;
				ctx.font = `${p.fontSize}px "Courier New", "Consolas", monospace`;
				ctx.textAlign = 'center';
				ctx.textBaseline = 'middle';
				ctx.fillText(p.char, p.x, p.y);
			}

			this.animationId = requestAnimationFrame(() => this.animate());
		}

		destroy() {
			this.isDestroyed = true;
			cancelAnimationFrame(this.animationId);
			window.removeEventListener('resize', this.resizeHandler);

			const heroBanner = document.getElementById('hero-banner');
			const target = heroBanner || this.canvas;
			if (target) {
				target.removeEventListener('mousemove', this.mouseMoveHandler);
				target.removeEventListener('mouseleave', this.mouseLeaveHandler);
				target.removeEventListener('touchmove', this.touchMoveHandler);
				target.removeEventListener('touchend', this.touchEndHandler);
			}
		}
	}

	interface AsciiParticle {
		x: number;
		y: number;
		originX: number;
		originY: number;
		vx: number;
		vy: number;
		char: string;
		fontSize: number;
		color: string;
	}

	// 滚动到内容区域
	function scrollToContent() {
		const banner = document.getElementById('hero-banner');
		if (banner) {
			const bannerHeight = banner.offsetHeight;
			window.scrollTo({
				top: bannerHeight - 80,
				behavior: 'smooth'
			});
		}
	}

	// 防止重复初始化
	let asciiLogoInstance: AsciiLogoSystem | null = null;

	function initHeroBanner() {
		const heroBanner = document.getElementById('hero-banner');
		if (!heroBanner || heroBanner.classList.contains('hidden')) {
			cleanupInstances();
			return;
		}

		cleanupInstances();

		const asciiCanvas = document.getElementById('ascii-canvas') as HTMLCanvasElement;
		if (asciiCanvas) {
			// 从 DOM data 属性读取 ASCII Art 数据（兼容 Swup 页面切换）
			const raw: string = heroBanner.getAttribute('data-ascii-logo') || 'QusMarsh';
			const lines = raw.split('\n').filter((l: string) => l.trimEnd().length > 0);
			asciiLogoInstance = new AsciiLogoSystem('ascii-canvas', lines);
		}

		const scrollIndicator = document.getElementById('scroll-indicator');
		if (scrollIndicator) {
			scrollIndicator.removeEventListener('click', scrollToContent);
			scrollIndicator.addEventListener('click', scrollToContent);
		}
	}

	function cleanupInstances() {
		if (asciiLogoInstance) {
			asciiLogoInstance.destroy();
			asciiLogoInstance = null;
		}
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initHeroBanner);
	} else {
		initHeroBanner();
	}

	if ((window as any).swup) {
		(window as any).swup.hooks.on('page:view', initHeroBanner);
	} else {
		document.addEventListener('swup:enable', () => {
			(window as any).swup.hooks.on('page:view', initHeroBanner);
		});
	}
</script>

<style>
	.hero-banner {
		position: relative;
		width: 100%;
		height: 100vh;
		min-height: 600px;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		overflow: hidden;
	}

	/* 背景层 */
	.hero-bg {
		position: absolute;
		inset: 0;
		z-index: 0;
	}

	/* 遮罩层 - 全透明 */
	.hero-overlay {
		position: absolute;
		inset: 0;
		z-index: 1;
		background: rgba(0, 0, 0, 0);
	}

	/* 主要内容 - 包裹 canvas */
	.hero-content {
		position: relative;
		z-index: 10;
		width: 100%;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.ascii-canvas {
		width: 100%;
		height: 100%;
		cursor: default;
	}

	/* 向下滚动指示器 */
	.hero-scroll-indicator {
		position: absolute;
		bottom: 2rem;
		left: 50%;
		transform: translateX(-50%);
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5rem;
		cursor: pointer;
		animation: floatUp 2s ease-in-out infinite;
		z-index: 10;
	}

	@keyframes floatUp {
		0%, 100% { transform: translateX(-50%) translateY(0); }
		50% { transform: translateX(-50%) translateY(-10px); }
	}

	.scroll-mouse {
		width: 24px;
		height: 38px;
		border: 2px solid rgba(255, 255, 255, 0.7);
		border-radius: 12px;
		position: relative;
	}

	.scroll-wheel {
		position: absolute;
		left: 50%;
		top: 8px;
		transform: translateX(-50%);
		width: 4px;
		height: 8px;
		background: rgba(255, 255, 255, 0.8);
		border-radius: 2px;
		animation: scrollWheel 1.5s ease-in-out infinite;
	}

	@keyframes scrollWheel {
		0%, 100% { 
			opacity: 1;
			transform: translateX(-50%) translateY(0);
		}
		50% { 
			opacity: 0.5;
			transform: translateX(-50%) translateY(8px);
		}
	}

	.scroll-text {
		font-size: 0.75rem;
		color: rgba(255, 255, 255, 0.7);
		letter-spacing: 0.1em;
	}

	.scroll-arrow {
		color: rgba(255, 255, 255, 0.7);
		font-size: 0.875rem;
		animation: arrowBounce 1.5s ease-in-out infinite;
	}

	@keyframes arrowBounce {
		0%, 100% { transform: translateY(0); }
		50% { transform: translateY(5px); }
	}

	@media (max-width: 768px) {
		.hero-scroll-indicator {
			bottom: 1.5rem;
		}
	}
</style>
