# Cloudflare Pages 静态资源缓存配置
# 参考: https://developers.cloudflare.com/pages/configuration/headers/

# 图片资源 - 1年不可变缓存
/*.webp
  Cache-Control: public, max-age=31536000, immutable

/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=31536000, immutable

# 字体资源
/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/*.woff
  Cache-Control: public, max-age=31536000, immutable

# Astro 构建产物 (带hash的文件)
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Pagefind 搜索资源
/pagefind/*
  Cache-Control: public, max-age=86400
